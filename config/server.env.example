# Non-secret production runtime contract. GitOps owns concrete values and External
# Secrets supplies POSTGRES_USER/POSTGRES_PASSWORD from AWS Secrets Manager.
POSTGRES_HOST=REPLACE_RDS_ENDPOINT
POSTGRES_PORT=5432
POSTGRES_DB=mlflow
POSTGRES_USER=REPLACE_FROM_EXTERNAL_SECRET
POSTGRES_PASSWORD=REPLACE_FROM_EXTERNAL_SECRET
MLFLOW_ARTIFACT_BUCKET=REPLACE_MLFLOW_ARTIFACT_BUCKET
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow.mlops.svc.cluster.local
MLFLOW_CORS_ALLOWED_ORIGINS=https://mlflow.example.com
MLFLOW_WORKERS=2
